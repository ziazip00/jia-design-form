{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "CommonJS",
    "moduleResolution": "Node",
    "outDir": ".test-build",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true
  },
  "include": [
    "tests/**/*.ts",
    "store/**/*.ts",
    "lib/designParser.ts",
    "lib/history.ts",
    "types/**/*.ts"
  ]
}
